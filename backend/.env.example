DATABASE_URL="mysql://pelita_app:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:3306/pelita_db"

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

PORT=4000

# Public URL of the frontend; use HTTPS in production.
FRONTEND_ORIGIN="http://localhost:3000"

NODE_ENV="development"

TRUST_PROXY=0

SEED_ADMIN_NAME="Pelita Super Admin"
SEED_ADMIN_EMAIL="replace-with-a-real-admin-email@example.com"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"

# Optional separate Kader account. Set all three values or leave all unset.
# To grant both roles to one login temporarily, use the same email and password as the admin above.
# SEED_KADER_NAME="Pelita Kader"
# SEED_KADER_EMAIL="replace-with-a-real-kader-email@example.com"
# SEED_KADER_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"

# Optional isolated integration-test database (database name must end in _test).
# PELITA_TEST_DATABASE_URL="mysql://pelita_test:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:3306/pelita_db_test"
